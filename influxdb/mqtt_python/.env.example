# MQTT Configuration
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=sensors/temperature,sensors/humidity,sensors/pressure,sensors/motion

# InfluxDB Configuration
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8181
INFLUXDB_TOKEN=your-admin-token-here
INFLUXDB_DATABASE=mqtt_data
INFLUXDB_ORG=your-org

# Analysis Configuration
TEMP_THRESHOLD_HIGH=30.0
TEMP_THRESHOLD_LOW=15.0
HUMIDITY_THRESHOLD_HIGH=80.0
