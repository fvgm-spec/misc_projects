{
  "name": "Daily Retail Analytics ETL Pipeline",
  "email_notifications": {
    "on_start": [],
    "on_success": [],
    "on_failure": []
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "data_ingestion",
      "description": "Ingest raw data into bronze layer",
      "notebook_task": {
        "notebook_path": "/Users/your-email@domain.com/01_data_ingestion",
        "base_parameters": {
          "environment": "production",
          "data_date": "{{ds}}"
        }
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        },
        "custom_tags": {
          "ResourceClass": "SingleNode",
          "Project": "RetailAnalytics"
        }
      },
      "timeout_seconds": 1800,
      "max_retries": 2,
      "retry_on_timeout": true
    },
    {
      "task_key": "bronze_to_silver",
      "description": "Transform bronze data to silver layer",
      "depends_on": [
        {
          "task_key": "data_ingestion"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Users/your-email@domain.com/02_bronze_to_silver",
        "base_parameters": {
          "environment": "production",
          "data_date": "{{ds}}"
        }
      },
      "existing_cluster_id": "{{cluster_id}}",
      "timeout_seconds": 1800,
      "max_retries": 2
    },
    {
      "task_key": "silver_to_gold",
      "description": "Create gold layer business metrics",
      "depends_on": [
        {
          "task_key": "bronze_to_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Users/your-email@domain.com/03_silver_to_gold",
        "base_parameters": {
          "environment": "production",
          "data_date": "{{ds}}"
        }
      },
      "existing_cluster_id": "{{cluster_id}}",
      "timeout_seconds": 1800,
      "max_retries": 2
    },
    {
      "task_key": "data_quality_check",
      "description": "Run data quality validation",
      "depends_on": [
        {
          "task_key": "silver_to_gold"
        }
      ],
      "sql_task": {
        "query": {
          "query_id": "your-query-id-here"
        },
        "warehouse_id": "your-warehouse-id-here"
      },
      "timeout_seconds": 600,
      "max_retries": 1
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "format": "MULTI_TASK"
}
